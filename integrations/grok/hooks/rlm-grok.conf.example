# RLM<->grok connection config. Copy to ~/.grok/rlm-grok.conf and edit.
# Read by rlm_grok_conf.py (env vars of the same name override these).
# The grok hooks (Windows/macOS/Linux) use these to reach the RLM node over SSH.

# Path to the SSH private key that can log in to the RLM node.
SSH_KEY=~/.ssh/id_ed25519

# The RLM node, as user@host (or host if your ssh config resolves the user).
SSH_HOST=user@your-node.example

# The RLM instance directory on the node (holds config.yaml + lattice.db + the node scripts).
REMOTE_DIR=/home/user/grok-agent-rlm

# The Python on the node that can import the RLM package (e.g. a venv with sqlite_vec, numpy).
REMOTE_PY=/home/user/.venv/bin/python3
